# Dark palette (GitHub Primer dark). Appended after a diagram to override
# palette.d2: `cat overview.d2 dark.d2 | d2 - overview-dark.svg`.
vars: {
  d2-config: {
    theme-id: 200
    theme-overrides: {
      N7: "#0d1117"
    }
  }
  text: "#f0f6fc"
  muted: "#9198a1"
  edge: "#6e7681"
  lane-fill: "#151b23"
  lane-stroke: "#3d444d"
  gate-fill: "#33290f"
  gate-stroke: "#d29922"
  step-fill: "#132640"
  step-stroke: "#4493f8"
  opt-fill: "#261f3d"
  opt-stroke: "#ab7df8"
  term-fill: "#13301f"
  term-stroke: "#3fb950"
}
