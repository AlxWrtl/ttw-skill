# Light palette (GitHub Primer colours) shared by every diagram.
# dark.d2 overrides these vars for the dark render; see README "Structure".
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
  text: "#1f2328"
  muted: "#59636e"
  edge: "#8c959f"
  lane-fill: "#f6f8fa"
  lane-stroke: "#d0d7de"
  gate-fill: "#fff8c5"
  gate-stroke: "#bf8700"
  step-fill: "#ddf4ff"
  step-stroke: "#0969da"
  opt-fill: "#fbefff"
  opt-stroke: "#8250df"
  term-fill: "#dafbe1"
  term-stroke: "#1a7f37"
}
